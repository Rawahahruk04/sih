# Copy to .env for local dev. NEVER commit .env.
# In CI/production these are GitHub Actions encrypted secrets.

AIPI_DATABASE_URL=postgresql+psycopg://aipi:aipi@localhost:5432/aipi

# --- Duffel (primary source) ------------------------------------------------
# A `duffel_test_` token is TEST mode. Verified 2026-08-26 on DEL-BOM: the API,
# schema and fare-brand fields are real, but the INVENTORY IS SIMULATED —
# offers come back from Duffel Airways (ZZ), British Airways and American
# Airlines on a Delhi-Mumbai domestic sector, with no IndiGo/SpiceJet/Akasa,
# and quoted in EUR. Test mode therefore exercises the collector; it does NOT
# produce a publishable Indian fare series. See docs/COLLECTION_RISK.md.
AIPI_DUFFEL_TOKEN=
AIPI_DUFFEL_VERSION=v2

# The index currency. Fares quoted in anything else are a hard error, not a
# conversion: FX-converting a quote makes the index move with the exchange rate.
AIPI_INDEX_CURRENCY=INR

# --- Amadeus (alternative source) -------------------------------------------
# IMPORTANT: the `test` environment serves a limited, largely CACHED dataset.
# An index built on cached data is flat and worthless. Run:
#     python -m aipi.collectors.driftcheck
# before trusting either source. See docs/COLLECTION_RISK.md.
AIPI_AMADEUS_CLIENT_ID=
AIPI_AMADEUS_CLIENT_SECRET=
AIPI_AMADEUS_ENV=test          # test | production

# Capture discipline: the index consumes exactly one slot per day (see basket.py).
AIPI_CAPTURE_SLOT_IST=06:30
AIPI_CAPTURE_TOLERANCE_MIN=45
