# Copy to .env for local dev. NEVER commit .env.
# In CI/production these are GitHub Actions encrypted secrets.

AIPI_DATABASE_URL=postgresql+psycopg://aipi:aipi@localhost:5432/aipi

# Amadeus Self-Service.
# IMPORTANT: the `test` environment serves a limited, largely CACHED dataset.
# An index built on cached data is flat and worthless. Run:
#     python -m aipi.collectors.driftcheck
# before trusting this source. See docs/COLLECTION_RISK.md.
AIPI_AMADEUS_CLIENT_ID=
AIPI_AMADEUS_CLIENT_SECRET=
AIPI_AMADEUS_ENV=test          # test | production

# Capture discipline: the index consumes exactly one slot per day (see basket.py).
AIPI_CAPTURE_SLOT_IST=06:30
AIPI_CAPTURE_TOLERANCE_MIN=45
